<UserControl x:Class="WinTool.App.Views.LinksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinTool.App.Localization">
    <UserControl.Resources>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Command" Value="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Help -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Center">
                    <TextBlock Text="?" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc LK_HelpTitle}" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="{loc:Loc LK_HelpBody}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Primary}" VerticalAlignment="Center"
                        Command="{Binding OpenCommand}" CommandParameter="{Binding HelpUrl}">
                    <TextBlock FlowDirection="LeftToRight">help.pcninja.pro ↗</TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- PcNinja free tools -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc LK_FreeTools}" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="{loc:Loc LK_FreeToolsSub}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="0,2,0,10" />
                    <WrapPanel>
                        <Button Style="{StaticResource LinkButton}" CommandParameter="{Binding DriverUpdaterUrl}" Content="Driver Updater ↗" />
                        <Button Style="{StaticResource LinkButton}" CommandParameter="{Binding ActivationUrl}">
                            <TextBlock><Run Text="{loc:Loc LK_Activation}" /><Run Text=" ↗" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource LinkButton}" CommandParameter="{Binding WebsiteUrl}" Content="www.pcninja.pro ↗" />
                        <Button Style="{StaticResource LinkButton}" CommandParameter="{Binding RepositoryUrl}">
                            <TextBlock><Run Text="{loc:Loc LK_Repo}" /><Run Text=" ↗" /></TextBlock>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{loc:Loc LK_FilePassword}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Password, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" Width="130"
                                 AutomationProperties.Name="{loc:Loc LK_FilePassword}" />
                        <Button Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding CopyPasswordCommand}" Content="{Binding CopyLabel}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Manufacturers -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{loc:Loc LK_Vendors}" Style="{StaticResource Text.CardTitle}" />
                <TextBlock Text="{loc:Loc LK_VendorsSub}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="0,2,0,10" />
                <WrapPanel>
                    <Button Style="{StaticResource LinkButton}" CommandParameter="{Binding DellUrl}" Content="Dell Drivers ↗" />
                    <Button Style="{StaticResource LinkButton}" CommandParameter="{Binding HpUrl}" Content="HP Support ↗" />
                    <Button Style="{StaticResource LinkButton}" CommandParameter="{Binding LenovoUrl}" Content="Lenovo Support ↗" />
                    <Button Style="{StaticResource LinkButton}" CommandParameter="{Binding AsusUrl}" Content="ASUS Support ↗" />
                </WrapPanel>
                <TextBlock Text="{loc:Loc LK_VendorsNote}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
