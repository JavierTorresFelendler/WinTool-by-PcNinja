<UserControl x:Class="WinTool.App.Views.OfficePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinTool.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Library messages and Office names are English: left-to-right in both languages. -->
        <Style x:Key="CoreText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style x:Key="SummaryRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,6" />
        </Style>

        <Style x:Key="NoticeBorder" TargetType="Border" BasedOn="{StaticResource Notice}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NoticeIsWarning}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Choices -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" IsEnabled="{Binding IsIdle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc OF_Family}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,5" />
                    <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,12">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource Segment}" GroupName="OfficeFamily" IsChecked="{Binding IsMicrosoft365}">
                                <TextBlock Text="Microsoft 365 Apps for Enterprise" TextWrapping="Wrap" TextAlignment="Center" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Segment}" GroupName="OfficeFamily" IsChecked="{Binding IsLtsc}">
                                <TextBlock Text="Office LTSC 2024 Professional Plus" TextWrapping="Wrap" TextAlignment="Center" />
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="{loc:Loc OF_Mode}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,5" />
                    <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,12">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource Segment}" GroupName="OfficeMode" IsChecked="{Binding IsInstallMode}">
                                <TextBlock Text="{loc:Loc OF_ModeInstall}" TextWrapping="Wrap" TextAlignment="Center" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Segment}" GroupName="OfficeMode" IsChecked="{Binding IsPackageMode}">
                                <TextBlock Text="{loc:Loc OF_ModePackage}" TextWrapping="Wrap" TextAlignment="Center" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Segment}" GroupName="OfficeMode" IsChecked="{Binding IsRemoveMode}">
                                <TextBlock Text="{loc:Loc OF_ModeRemove}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.Danger}" />
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <!-- Remove all -->
                    <Border Style="{StaticResource Notice.Warning}" Visibility="{Binding IsRemoveMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc OF_RemoveWarning}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.WarnText}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc OF_Channel}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" DisplayMemberPath="Name" MinWidth="0"
                                          AutomationProperties.Name="{loc:Loc OF_Channel}"
                                          Visibility="{Binding IsMicrosoft365, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{loc:Loc OF_ChannelLtsc}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding IsLtsc, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc OF_Arch}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Architectures}" SelectedIndex="{Binding ArchitectureIndex}" MinWidth="0"
                                          AutomationProperties.Name="{loc:Loc OF_Arch}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Loc OF_Apps}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Apps}" Margin="0,0,0,12" FlowDirection="LeftToRight">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Id}" Margin="0,0,10,7" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Loc OF_Languages}" Style="{StaticResource Text.Label}" FontSize="12" />
                        <TextBlock Text="{loc:Loc OF_LanguagesHint}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding Languages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tag}" Margin="0,0,6,6" Padding="8,2,2,2">
                                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource Button.Link}" Padding="6,0" Margin="4,0,0,0" Content="✕" FontSize="11"
                                                        Command="{Binding DataContext.RemoveLanguageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Id}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource Button.Secondary}" Padding="10,2" Margin="0,0,0,6" Command="{Binding ToggleAddLanguageCommand}">
                                <TextBlock><Run Text="+ " /><Run Text="{loc:Loc OF_AddLanguage}" /></TextBlock>
                            </Button>
                        </WrapPanel>
                        <Border Visibility="{Binding AddingLanguage, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12" Padding="10"
                                CornerRadius="8" Background="{DynamicResource Brush.Raised}">
                            <StackPanel>
                                <TextBox Text="{Binding LanguageSearch, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                         AutomationProperties.Name="{loc:Loc OF_SearchLanguage}" Margin="0,0,0,8" />
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AvailableLanguages}" FlowDirection="LeftToRight">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Button.Secondary}" Padding="8,2" Margin="0,0,6,6" Content="{Binding}" FontSize="12"
                                                        Command="{Binding DataContext.AddLanguageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{loc:Loc OF_Addons}" Style="{StaticResource Text.Label}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,8" />
                            <CheckBox IsChecked="{Binding Visio}" Content="Visio" Margin="0,0,18,8" />
                            <CheckBox IsChecked="{Binding Project}" Content="Project" Margin="0,0,0,8" />
                        </WrapPanel>

                        <CheckBox IsChecked="{Binding AutoActivate}" Content="{loc:Loc OF_AutoActivate}" Margin="0,4,0,0"
                                  Visibility="{Binding IsLtsc, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox IsChecked="{Binding RemoveExisting}" Content="{loc:Loc OF_RemoveExisting}" Margin="0,8,0,0"
                                  Visibility="{Binding IsInstallMode, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsPackageMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc OF_PackageFolder}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PackageFolder, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MinWidth="0"
                                         AutomationProperties.Name="{loc:Loc OF_PackageFolder}" />
                                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Padding="10,4"
                                        Command="{Binding ChooseFolderCommand}" Content="{loc:Loc OF_ChooseFolder}" />
                            </Grid>
                            <TextBlock Text="{loc:Loc OF_PackageHint}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Summary and action -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc OF_Summary}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,10" />
                        <Border Padding="12,10" CornerRadius="8" Background="{DynamicResource Brush.Raised}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc OF_Current}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                                <TextBlock Text="{Binding InstalledText}" Style="{StaticResource CoreText}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InstalledDetails}" Style="{StaticResource CoreText}" Foreground="{DynamicResource Brush.Muted}" />
                                <TextBlock Text="{loc:Loc OF_WillReplace}" Style="{StaticResource Text.Body}" FontSize="12.5" Foreground="{DynamicResource Brush.WarnText}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding WillReplace, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource SummaryRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc OF_Family}" Style="{StaticResource Text.Label}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding FamilyName}" Style="{StaticResource CoreText}" FontSize="13" HorizontalAlignment="Right" TextAlignment="Right" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SummaryRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc OF_Channel}" Style="{StaticResource Text.Label}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChannelText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SummaryRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc OF_Apps}" Style="{StaticResource Text.Label}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding AppsSummary}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SummaryRow}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc OF_Languages}" Style="{StaticResource Text.Label}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding LanguagesSummary}" Style="{StaticResource CoreText}" FontSize="13" HorizontalAlignment="Right" TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc OF_LicenseNote}" Style="{StaticResource Text.Label}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12" />

                        <Button Style="{StaticResource Button.Primary}" Command="{Binding RunCommand}" Content="{Binding RunLabel}" HorizontalAlignment="Stretch"
                                Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Danger}" Command="{Binding RunCommand}" Content="{Binding RunLabel}" HorizontalAlignment="Stretch"
                                Visibility="{Binding IsRemoveMode, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Progress -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ProgressBar Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                            <Button Style="{StaticResource Button.Secondary}" HorizontalAlignment="Right" Margin="0,8,0,0"
                                    Command="{Binding CancelCommand}" Content="{loc:Loc OF_Cancel}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Result -->
                <Border Style="{StaticResource NoticeBorder}" Margin="0,14,0,0" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Notice}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NoticeDetail}" Style="{StaticResource CoreText}" Margin="0,4,0,0"
                                   Visibility="{Binding HasNoticeDetail, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding OpenResultCommand}"
                                Content="{loc:Loc OF_OpenPackage}" Visibility="{Binding HasResultFolder, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Details -->
                <Expander Header="{loc:Loc OF_Log}" Margin="0,14,0,0" Visibility="{Binding HasLog, Converter={StaticResource BoolToVisibility}}"
                          Foreground="{DynamicResource Brush.Text}">
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" TextWrapping="Wrap"
                             MaxHeight="200" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" Margin="0,6,0,0" />
                </Expander>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
