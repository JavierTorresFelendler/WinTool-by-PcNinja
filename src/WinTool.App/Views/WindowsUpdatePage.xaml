<UserControl x:Class="WinTool.App.Views.WindowsUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinTool.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="MessageBorder" TargetType="Border" BasedOn="{StaticResource Notice}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScheduleMessageText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ScheduleMessageIsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding LastCheckText}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Button.Soft}" VerticalAlignment="Bottom"
                    Command="{Binding ScanCommand}" Content="{loc:Loc WU_CheckForUpdates}" />
        </Grid>

        <!-- WinUpdate Tool V1/V2 found (D-015) -->
        <Border Style="{StaticResource Notice.Warning}" Margin="0,0,0,14" Visibility="{Binding LegacyDetected, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc WU_Legacy_Found}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.WarnText}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" Command="{Binding TakeOverCommand}" Content="{loc:Loc WU_Legacy_TakeOver}" />
            </Grid>
        </Border>

        <!-- Status strip -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/WinTool-by-PcNinja;component/Assets/pcninja-mascot.png" Width="52" Height="52" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CountText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>
                <Border Grid.Column="2" Width="1" Background="{DynamicResource Brush.Divider}" Margin="0,4,18,4" />
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding RestartPending, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Style="{StaticResource StatusDot}" Tag="Warning" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc WU_RestartPending}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{loc:Loc WU_NoRestart}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RestartPending}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <WrapPanel Grid.Column="4" VerticalAlignment="Center">
                    <!-- A pending restart blocks installing: Restart Now leads, Install waits (owner VM test). -->
                    <Button Style="{StaticResource Button.Primary}" Margin="0,0,8,0" Command="{Binding RestartCommand}" Content="{loc:Loc WU_RestartNow}"
                            Visibility="{Binding RestartPending, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding InstallCommand}" Content="{loc:Loc WU_InstallSelected}"
                            ToolTip="{loc:Loc WU_InstallAfterRestart}" ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding RestartPending, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding InstallCommand}" Content="{loc:Loc WU_InstallSelected}"
                            Visibility="{Binding NoRestartPending, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Progress -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ProgressText}" ToolTip="{Binding ProgressText}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="100" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Margin="14,0,0,0" VerticalAlignment="Center"
                        Command="{Binding CancelCommand}" Content="{loc:Loc WU_Cancel}" />
            </Grid>
        </Border>

        <!-- Result message -->
        <Border Style="{StaticResource MessageBorder}" Margin="0,0,0,14" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" MinWidth="320" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Available updates -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc WU_Available}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Loc WU_PressCheck}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasScanned}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{loc:Loc WU_NoUpdates}" Style="{StaticResource Text.Subtitle}"
                                   Visibility="{Binding NoUpdatesFound, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding IsIdle}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}" />
                                            <StackPanel Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                <TextBlock Text="{Binding Result}" FontSize="12" Foreground="{DynamicResource Brush.Muted}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Result}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Tag}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="11.5" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" MinWidth="56"
                                                       TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Health and maintenance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc WU_Health}" Style="{StaticResource Text.CardTitle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding HealthOverallName}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HealthSummary}" Margin="6,0,0,0" FontSize="12.5" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding HealthRows}" Focusable="False" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding StatusName}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}" Margin="8,0,0,0" FontSize="12.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding HealthCheckCommand}" Content="{loc:Loc WU_RunHealthCheck}" />
                            <Button Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding CollectLogsCommand}" Content="{loc:Loc WU_CollectLogs}" />
                            <Button Style="{StaticResource Button.Danger}" Margin="0,0,8,8" Command="{Binding ResetCommand}" Content="{loc:Loc WU_Reset}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Schedule, edited in place -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc WU_Schedule}" Style="{StaticResource Text.CardTitle}" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" Content="{loc:Loc WU_Schedule_On}" />
                    </Grid>
                    <UniformGrid Rows="1" Margin="0,0,0,10">
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Frequency" Margin="0,0,4,0" IsChecked="{Binding IsDaily, Mode=TwoWay}" Content="{loc:Loc WU_Daily}" />
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Frequency" Margin="0,0,4,0" IsChecked="{Binding IsWeekly, Mode=TwoWay}" Content="{loc:Loc WU_Weekly}" />
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Frequency" Margin="0,0,4,0" IsChecked="{Binding IsMonthly, Mode=TwoWay}" Content="{loc:Loc WU_Monthly}" />
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Frequency" IsChecked="{Binding IsStartup, Mode=TwoWay}" Content="{loc:Loc WU_Startup}" />
                    </UniformGrid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Visibility="{Binding ShowDay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc WU_Day}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Days}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding DayOfWeek, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowMonthDay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc WU_MonthDay}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding MonthDays}" SelectedItem="{Binding MonthlyDay, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Visibility="{Binding ShowTime, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc WU_Time}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding RunAtStartup, Mode=TwoWay}" Content="{loc:Loc WU_RunAtStartup}"
                              Visibility="{Binding ShowRunAtStartup, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding RunIfMissed, Mode=TwoWay}" Content="{loc:Loc WU_RunIfMissed}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding WakeToRun, Mode=TwoWay}" Content="{loc:Loc WU_Wake}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding AutoRetry, Mode=TwoWay}" Content="{loc:Loc WU_AutoRetry}" />
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding RebootPrompt, Mode=TwoWay}" Content="{loc:Loc WU_RebootPrompt}" />
                    <CheckBox Margin="0,0,0,12" IsChecked="{Binding InstallFirmware, Mode=TwoWay}" Content="{loc:Loc WU_Firmware}" />
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc WU_NextRun}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
                                <TextBlock Text="{Binding NextRun}" FontSize="12.5" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.Soft}" Command="{Binding SaveScheduleCommand}" Content="{loc:Loc WU_Save}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding ScheduleMessage}" Style="{StaticResource ScheduleMessageText}" Margin="0,10,0,0"
                               Visibility="{Binding HasScheduleMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
