<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>WinTool.App</RootNamespace>
    <AssemblyName>WinTool-by-PcNinja</AssemblyName>
    <ApplicationIcon>Assets\PcNinja.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>WinTool.App.Program</StartupObject>
    <AssemblyTitle>WinTool by PcNinja</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTool.Core\WinTool.Core.csproj" />
    <ProjectReference Include="..\WinTool.WindowsUpdate\WinTool.WindowsUpdate.csproj" />
    <ProjectReference Include="..\WinTool.Cli\WinTool.Cli.csproj" />
    <Compile Include="..\..\shared\PcNinjaSingleInstance.cs" Link="Shared\PcNinjaSingleInstance.cs" />
  </ItemGroup>

  <!-- Program.Main owns startup, so App.xaml is a plain page, not the application definition. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\pcninja-mascot.png" />
    <Resource Include="Assets\PcNinja.ico" />
  </ItemGroup>

  <!-- Every language is a neutral resource inside WinTool-by-PcNinja.exe (no satellite folders), so the portable EXE is one file. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.he.resx" WithCulture="false" LogicalName="WinTool.App.Localization.Strings.he.resources" />
    <EmbeddedResource Update="Localization\Strings.resx" LogicalName="WinTool.App.Localization.Strings.resources" />
  </ItemGroup>

  <!-- Embed referenced assemblies (WinTool.Core.dll, ...) so WinTool-by-PcNinja.exe runs on its own. See Infrastructure\EmbeddedAssemblies.cs. -->
  <Target Name="EmbedReferencedAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>WinTool.Embedded.%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
