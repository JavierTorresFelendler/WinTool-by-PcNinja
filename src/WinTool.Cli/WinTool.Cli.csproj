<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48 is the product; net10.0-windows is the secondary development/test target. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <RootNamespace>WinTool.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinTool.Core\WinTool.Core.csproj" />
    <ProjectReference Include="..\WinTool.WindowsUpdate\WinTool.WindowsUpdate.csproj" />
    <ProjectReference Include="..\WinTool.Upgrade\WinTool.Upgrade.csproj" />
    <ProjectReference Include="..\WinTool.Office\WinTool.Office.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WinTool.WindowsUpdate.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
