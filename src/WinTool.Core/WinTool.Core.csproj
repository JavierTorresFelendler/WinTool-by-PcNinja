<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48 is the product; net10.0-windows is the secondary development/test target. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <RootNamespace>WinTool.Core</RootNamespace>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" Condition="'$(TargetFramework)' == 'net48'" />
    <Reference Include="System.Net.Http" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\Polyfills\*.cs" LinkBase="Polyfills" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WinTool.Core.Tests" />
  </ItemGroup>
</Project>
