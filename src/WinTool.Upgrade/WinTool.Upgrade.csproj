<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48 is the product; net10.0-windows is the secondary development/test target. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <RootNamespace>WinTool.Upgrade</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET Framework reference assemblies carry no nullable annotations, so only the annotations are kept there. -->
    <Nullable Condition="'$(TargetFramework)' == 'net48'">annotations</Nullable>
    <Nullable Condition="'$(TargetFramework)' != 'net48'">enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinTool.Core\WinTool.Core.csproj" />
    <Compile Include="..\Shared\Polyfills\*.cs" LinkBase="Polyfills" />
    <InternalsVisibleTo Include="WinTool.Upgrade.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Using Include="WinTool" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
</Project>
