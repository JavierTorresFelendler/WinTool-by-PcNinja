<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48 is the product; net10.0-windows is the secondary development/test target. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <RootNamespace>WinTool.WindowsUpdate</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinTool.Core\WinTool.Core.csproj" />
    <InternalsVisibleTo Include="WinTool.WindowsUpdate.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>
</Project>
