<Project>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)IsolatedTestFramework.cs" Link="IsolatedTestFramework.cs" />
    <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
      <_Parameter1>WinTool.Tests.IsolatedTestFramework</_Parameter1>
      <_Parameter2>$(AssemblyName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
